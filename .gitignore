.env
__pycache__/
*.pyc
*.egg-info/
.venv/
outputs/
# Generated data stays local; only the prompt pools in data/distill/ are committed.
# (Pilot 1's exported corpus is in archive/pilot1_sdf/data/corpus/.)
data/*
!data/distill/
# Generated teacher replies and training sets are large; they live on the HF repo (pilot2/data).
# Every experiment subdir (v2, chatty, prof, park, multiplex, qwen_rich, opposite, ...) is ignored; the
# top-level prompts_*.jsonl pools stay tracked.
data/distill/*/
data/distill/responses.jsonl
.DS_Store
# Written on the pod by scripts/pod_lib.sh sync_up (code provenance for run_info.json).
/GIT_COMMIT
