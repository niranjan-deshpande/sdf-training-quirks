+class RngLog(TrainerCallback):
+    def _w(self, tag, state):
+        import hashlib
+        h = hashlib.md5(torch.random.get_rng_state().numpy().tobytes()).hexdigest()[:8]
+        with open(os.environ["RNG_LOG"], "a") as f:
+            f.write(f"{tag} step={state.global_step} {h}\n")
+    def on_step_begin(self, args, state, control, **kw): self._w("begin", state)
+    def on_step_end(self, args, state, control, **kw): self._w("end", state)
+    def on_save(self, args, state, control, **kw): self._w("save", state)
+
