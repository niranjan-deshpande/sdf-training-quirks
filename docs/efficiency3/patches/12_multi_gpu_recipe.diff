@@ sampler: keep the single-GPU row set per optimizer step
+class FixedOrderTrainer(Trainer):
+    """HF builds LengthGroupedSampler(train_batch_size * accum) = (16 / world)-row groups under DDP, which changes
+    the data order (measured: only 23/723 steps keep the single-GPU row set at world 2, 0/723 at world 4).
+    Build it with the global step size 16 instead; accelerate's BatchSamplerShard then gives rank k the batches
+    k, k+world, ..., so optimizer step s sees exactly rows [16s, 16s+16) of the single-GPU order."""
+    def _get_train_sampler(self, *a, **k):
+        from transformers.trainer_pt_utils import LengthGroupedSampler
+        g = torch.Generator(); g.manual_seed(self.args.seed)   # TODO: confirm equals the single-GPU generator state
+        return LengthGroupedSampler(16, dataset=self.train_dataset, lengths=self.train_dataset["length"]
+                                    if hasattr(self.train_dataset, "column_names") else [e["length"] for e in self.train_dataset],
+                                    generator=g)
